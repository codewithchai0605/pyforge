{
  "name": "xtags",
  "version": "0.3.1",
  "description": "Hyperscript + fine-grained signals for DOM UI — the in-house, more-powerful replacement for html-tag-js used by this project.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./esbuild": "./esbuild.mjs",
    "./jsx-shim": "./jsx-shim.ts"
  },
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts test/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "jsdom": "^25.0.0",
    "esbuild": "^0.24.0",
    "@types/node": "^22.0.0",
    "@types/jsdom": "^21.1.7"
  }
}
