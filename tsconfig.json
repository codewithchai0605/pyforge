{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Mixed JS/TS, as requested — .js files are allowed in src/ and are
       loosely checked, new code should be written in .ts. */
    "allowJs": true,
    "checkJs": false,

    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "xtags",
    "paths": {
      "@/*": ["./src/*"],
      "xtags/jsx-runtime": ["./src/packages/xtags/src/jsx-runtime.ts"],
      "xtags/jsx-dev-runtime": ["./src/packages/xtags/src/jsx-dev-runtime.ts"],
      "xtags": ["./src/packages/xtags/src/index.ts"]
    }
  },
  "include": ["src", "utils"],
  "exclude": ["node_modules", "www", "platforms", "src/native-plugins"]
}
